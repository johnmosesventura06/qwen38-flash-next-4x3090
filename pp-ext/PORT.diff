+        return
+    pp = get_pp_group()
+    if pp.world_size < 2 or pp.is_first_rank:
+        return
+    inner = _inner_decoder(model)
+    if inner is None or not getattr(inner, "supports_aux_hidden_states_over_pp", False):
+        return
+
+    num_aux_states = inner._aux_slot_base_cached
+    if num_aux_states == 0:
