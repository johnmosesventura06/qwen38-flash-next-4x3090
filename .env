# lane-3090 (owner 10-28): 4x RTX 3090 TP4 base benched 10-28 (Bucko 939905b + TP4
# adaptation, image tp4-clean:locked) + the golden-lane patches (golden-ext/ grafts).
# Owner order: "i need atleast 5 lanes. then 512k kv cache, yarn and durable kv just like
# in strata ... kv cache should be 8bit ... the ple table should be what uncensored is
# using which is the stock bf16" + "make sure ple is also loaded from the nvme instead of ram".
# Rollback: git checkout 2fd318e (benched baseline) on branch lane-3090.
# JSON values are SINGLE-QUOTED: this file is `source`d.
IMAGE=qwen38-flash-next-tp4-clean:locked
MODEL_DIR=/home/ai-host/models/Qwen3.8-Flash-Next-W4A16-FP8PLE
SERVED_MODEL_NAME=Qwen3.8-Flash-Next
PORT=8000
BIND=0.0.0.0

# --- GPUs: 4x 3090, all Gen4 x4 on the bifurcation card, 280 W (gpu-power-cap.service) ---
TP_SIZE=4
CUDA_VISIBLE_DEVICES=0,1,2,3
DISABLE_CUSTOM_ALL_REDUCE=0
# NCCL_P2P_LEVEL=SYS   # off (10-28): golden 5060 Ti setting; on 4x3090 PCIe NCCL is faster (C=4 281 -> 355)
# NCCL_PROTO unset (owner 10-28): NCCL auto-picks LL for the small decode all-reduces (golden forced Simple for the 5060 Tis)
# VLLM_CUSTOM_ALL_GATHER=1   # off (10-28): golden 5060 Ti setting; on 4x3090 PCIe NCCL is faster (C=4 281 -> 355)
# VLLM_CUSTOM_AR_ALLOW_PCIE=1   # off (10-28): golden 5060 Ti setting; on 4x3090 PCIe NCCL is faster (C=4 281 -> 355)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# --- Experts: FULL FIT on the GPUs (owner 10-28: "let's make it 256k so it wont activate streaming").
# OFFLOAD=0 -> no UVA experts, no hot/cold LRU, no stream-stage. (512K needed 16 rows/card in RAM: ~108-130 tok/s.)
CPU_OFFLOAD_GB=0
VLLM_WNA16_STATIC_HOT_CACHE_SIZE=128
VLLM_WNA16_STATIC_HOT_CACHE_MAX_TOKENS=11
# = hot rows // top-k (112 // 10): the LRU path never overflows the cache; bigger steps take the tiered path.

# --- Slots / context: 5 lanes sharing a 256K pool (native 262,144: no YaRN) ---
MAX_NUM_SEQS=5
MAX_MODEL_LEN=262144
# VLLM_ALLOW_LONG_MAX_MODEL_LEN=1   # 512K only
# HF_OVERRIDES_JSON='{"text_config":{"max_position_embeddings":524288,"rope_parameters":{"rope_type":"yarn","factor":2.0,"original_max_position_embeddings":262144,"attn_factor":1.0,"beta_fast":32,"beta_slow":1,"mrope_interleaved":true,"mrope_section":[11,11,10],"partial_rotary_factor":0.25,"rope_theta":10000000}},"max_position_embeddings":524288}'   # 512K only (YaRN x2)
# 8-bit KV: fp8 e5m2 (owner 10-28: "use fp8 e5m2"): Triton converts fp8e5 natively on sm_86; e4m3 needed a software decode (prefill 2.5x slower).
KV_CACHE_DTYPE=fp8_e5m2
KV_CACHE_MEMORY_BYTES=2220000000
# 2048-token prefill chunks = floor (owner 10-28: "we cannot go below 2048 prefill"; 1024 measured 2x slower prefill).
MAX_NUM_BATCHED_TOKENS=2048
MAX_PARALLEL_LOADING_WORKERS=1
# CUDA graphs for every MTP-3 decode step size (5 seqs x 4 tokens). The default list skips 12/20:
# C=5 ran eager (222 tok/s) -> 319 with these sizes.
COMPILATION_CONFIG='{"mode":0,"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[4,8,12,16,20]}'

# --- Durable KV (golden disk tier): prefix KV persisted on the 990 Pro, survives restarts.
# PYTHONHASHSEED pins the block hashes so a restart finds its own journal again.
KV_TIER_DIR=/home/ai-host/models/kv-tier
KV_TIER_JSON='{"kv_connector":"SimpleCPUOffloadConnector","kv_role":"kv_both","kv_connector_extra_config":{"kv_offload_backend":"disk","disk_path":"/kv_tier/lane3090","disk_capacity_bytes":107374182400,"disk_buffer_slots":16,"persist":true}}'
PYTHONHASHSEED=1888275146
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=1600

# --- PLE: FP8 table prefaulted in RAM (owner 10-28: "yes let's move it to ram"; NVMe BF16 measured -11% decode; BF16 in RAM = 102 GB, too big) ---
# PLE_ARM_DISK8=1   # NVMe variant
# PLE_BF16_TABLE=1
PLE_DISK8_DIR=/home/ai-host/models/ple-disk8-bf16
QWEN38_PLE_PREFAULT=1
VLLM_PLE_OFFLOAD_READY_TIMEOUT=1800

# --- MTP 3 (benched: acceptance length 3.40, 157 tok/s single) ---
MTP_DEPTH=3
# Draft folder = runtime/mtp-int4-g32 hard-linked, config.json with the same YaRN x2 (dict hf-overrides skip the draft).
# MTP_MODEL_DIR=/home/ai-host/models/mtp-int4-g32-yarn2   # 512K only: YaRN draft config; native 256K uses the stock draft
VLLM_MTP_DRAFT_VOCAB_RANGES=[[0,65536],[248044,248320]]

# --- Bucko runtime knobs (unchanged from the benched base) ---
VLLM_QSA_EXACT_TOPK=0
QWEN38_STREAM_STAGE=1
QWEN38_STREAM_STAGE_MIN_TOKENS=1536
QWEN38_STAGE_OVERLAP=1
QWEN38_ASYNC_SCHEDULING=1
QWEN38_TRITON_SKINNY=1
ENABLE_VISION=0   # owner 10-28: "turn off vision for now"
VISION_MAX_IMAGES=5
VISION_MAX_PIXELS=1048576
JIT_CACHE_DIR=./jit-cache-3090

# --- Reasoning-effort tier (golden owner knob 2026-09-28, same values as golden) ---
# medium + LOCK=1 hard-sets the tier for every request. Stock = delete these two lines.
# REASONING_EFFORT=medium   # owner 10-28: back to stock (template default = xhigh)
# REASONING_EFFORT_LOCK=1
