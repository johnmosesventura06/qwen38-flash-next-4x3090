# Target: 2x 5060 Ti + 4x 3090 as PP3 x TP2 (5060 Tis on the two M.2 CPU-lane slots, their own 550 W PSU).
# Stage 0 = 5060 Tis (8 layers: embed/PLE/vision), stages 1/2 = 3090 pairs (20 + 20; last has lm_head + MTP).
# Everything fits on the GPUs (128 GB): no expert offload. TP2 halves KV duplication -> big pool possible.
PP_GRAFTS=1
PP_SIZE=3
TP_SIZE=2
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=__5060A__,__5060B__,__3090A__,__3090B__,__3090C__,__3090D__
VLLM_PP_LAYER_PARTITION=8,20,20
CPU_OFFLOAD_GB=0
KV_CACHE_MEMORY_BYTES=1900000000
KV_TIER_DIR=/home/ai-host/models/kv-tier-pp3
JIT_CACHE_DIR=./jit-cache-pp3
