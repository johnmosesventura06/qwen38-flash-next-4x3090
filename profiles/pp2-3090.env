# PP2 x TP2 on the current 4x 3090 (software de-risk before any card swap). Overrides ../.env.
# Stage 0 = GPU 0,1 (embedding, PLE, vision, layers 0-24), stage 1 = GPU 2,3 (layers 25-47, lm_head, MTP draft).
# Stage 1 also carries the draft's own embed copy (+~0.64 GiB/card), so stage 0 takes one layer more.
PP_GRAFTS=1
PP_SIZE=2
TP_SIZE=2
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0,1,2,3
VLLM_PP_LAYER_PARTITION=25,23
# TP2 holds 1 of the 2 KV heads per card (TP4 duplicated them), so the same bytes hold ~2x the tokens.
# Start at 1.9 GB and READ the boot log: "GPU KV cache size" must stay >= 262,144 (owner floor).
KV_CACHE_MEMORY_BYTES=3000000000
# New rank layout -> the durable tier refuses the old journal; keep production's tier untouched.
KV_TIER_DIR=/home/ai-host/models/kv-tier-pp
JIT_CACHE_DIR=./jit-cache-pp
# Stage 0 and 1 pick different hybrid block sizes (1664 vs 3200) -> CSA grouping refuses; pin one.
# Checkpoint says mamba_ssm_dtype float32, but under PP only the drafter stage applies it (stage 0 = bf16) -> pin it like TP4 prod.
EXTRA_VLLM_ARGS="--block-size 3200 --mamba-ssm-cache-dtype float32"
# GDN state checkpoints must sit on block boundaries (block 3200 here, 1600 in TP4).
VLLM_PREFIX_CACHE_RETENTION_INTERVAL=3200
